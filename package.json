{
  "name": "stock-market-watchlist",
  "version": "1.0.0",
  "description": "A stock market web app with React frontend, Node.js backend, and Supabase integration",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "stock-market",
    "react",
    "nodejs",
    "supabase",
    "kotak-api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "csv-parse": "^6.1.0"
  }
}
